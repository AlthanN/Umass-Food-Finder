# Preferred names for newer Upstash integrations.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Existing Vercel KV integrations may provide these names instead. A deployment
# only needs one complete pair, so do not duplicate real credentials here.
# KV_REST_API_URL=https://example.upstash.io
# KV_REST_API_TOKEN=replace-me

# Generate a random value containing at least 16 characters.
CRON_SECRET=replace-with-a-long-random-secret

# Generate a separate random secret for the private search-metrics endpoint.
ANALYTICS_SECRET=replace-with-a-different-long-random-secret

# Copy the HTML script path shown by Vercel after enabling Web Analytics.
VERCEL_ANALYTICS_SCRIPT_SRC=/your-vercel-analytics-path/script.js

# Public form ID from the endpoint Formspree assigns to your feedback form.
FORMSPREE_FORM_ID=replace-with-your-form-id
# UMass Dining source endpoints used by the menu scraper.
UMASS_MENU_PAGE_URL=replace-with-menu-page-url
UMASS_MENU_API_URL=replace-with-menu-api-url
# Set true to show the pause screen and disable searches; false restores the app.
# Restart locally or redeploy on Vercel after changing this value.
APP_PAUSED=false
